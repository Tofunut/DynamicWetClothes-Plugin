#include "/Engine/Public/Platform.ush"
#include "/DWCGPU/DWCSurfaceStampCommon.ush"

StructuredBuffer<uint4> TexelLookup;
StructuredBuffer<float4> TriangleFlow;
StructuredBuffer<float4> TriangleMetric;
StructuredBuffer<float4> TriangleDataToSurfaceWaterNormalUV;
RWTexture2D<float4> TargetSurface;

int2 TextureSize;
uint TriangleCount;
int2 StampMinPixel;
int2 StampDispatchSize;
float2 StampUV;
float2 StampCenterPixels;
float2 StampHalfSizePixels;
float StampAmount;
float StampTimeSeconds;
float StampLifetimeSeconds;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    if (any(DispatchThreadID.xy >= uint2(StampDispatchSize))) return;

    uint4 Lookup;
    if (!DWC_ResolveStampLookup(StampUV, TextureSize, TexelLookup, Lookup)) return;
    if (Lookup.x >= TriangleCount) return;
    const float4 Flow = TriangleFlow[Lookup.x];
    const float4 Metric = TriangleMetric[Lookup.x];
    if (Flow.w <= 0.0 || Metric.w <= 0.0) return;

    const float DirectionLengthSquared = dot(Flow.xy, Flow.xy);
    if (DirectionLengthSquared <= 1.0e-12) return;
    const float2 Direction = Flow.xy * rsqrt(DirectionLengthSquared);
    const float2 Perpendicular = float2(-Direction.y, Direction.x);

    const float4 DataToNormal = TriangleDataToSurfaceWaterNormalUV[Lookup.x];
    float2 NormalUVDirection = float2(
        DataToNormal.x * Direction.x + DataToNormal.y * Direction.y,
        DataToNormal.z * Direction.x + DataToNormal.w * Direction.y);
    const float NormalDirectionLengthSquared = dot(NormalUVDirection, NormalUVDirection);
    if (NormalDirectionLengthSquared > 1.0e-12)
    {
        NormalUVDirection *= rsqrt(NormalDirectionLengthSquared);
    }
    else
    {
        NormalUVDirection = Direction;
    }

    const float FlowAngle = atan2(NormalUVDirection.y, NormalUVDirection.x);
    const float EncodedFlowAngle = FlowAngle / 6.28318530718 + 0.5;

    const int2 Pixel = StampMinPixel + int2(DispatchThreadID.xy);
    if (any(Pixel < 0) || any(Pixel >= TextureSize)) return;

    // Keep the brush inside the same packed Data-UV island as its resolved center.
    // This prevents a large stamp from crossing padding into an adjacent island.
    const uint4 PixelLookup = TexelLookup[Pixel.y * TextureSize.x + Pixel.x];
    if (!DWC_IsValidLookup(PixelLookup) || PixelLookup.w != Lookup.w) return;

    const float2 Delta = (float2(Pixel) + 0.5) - StampCenterPixels;
    const float2 Local = float2(
        dot(Delta, Perpendicular) / max(StampHalfSizePixels.x, 0.5),
        dot(Delta, Direction) / max(StampHalfSizePixels.y, 0.5));
    DWC_WriteRivuletStamp(
        Pixel,
        DWC_StampBrush(Local),
        StampAmount,
        StampTimeSeconds,
        StampLifetimeSeconds,
        EncodedFlowAngle,
        TargetSurface);
}
