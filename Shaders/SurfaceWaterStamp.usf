#include "/Engine/Private/Common.ush"

Texture2D FlowMap;
SamplerState FlowSampler;
RWTexture2D<float4> TargetSurface;

int2 Resolution;
int2 StampMinPixel;
int2 StampDispatchSize;
float2 StampCenterPixels;
float2 StampHalfSizePixels;
float StampAmount;
float StampTimeSeconds;
float StampLifetimeSeconds;
uint bFlowStamp;
uint bHasFlowMap;

float AccumulationBrush(float2 LocalPosition)
{
    const float Radius = length(LocalPosition);
    // RT stores only a smooth amount region. Final droplet shape and normal are
    // sampled from static detail textures in MF_DWC_ApplyWetness.
    return 1.0 - smoothstep(0.82, 1.0, Radius);
}

[numthreads(8, 8, 1)]
void StampCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= uint2(StampDispatchSize))) return;

    const int2 Pixel = StampMinPixel + int2(DispatchThreadId.xy);
    if (any(Pixel < 0) || any(Pixel >= Resolution)) return;

    const float2 UV = (float2(Pixel) + 0.5) / float2(Resolution);
    float2 Direction = float2(0.0, 1.0);
    if (bFlowStamp != 0 && bHasFlowMap != 0)
    {
        Direction = FlowMap.SampleLevel(FlowSampler, UV, 0).rg * 2.0 - 1.0;
        const float LengthSquared = dot(Direction, Direction);
        Direction = LengthSquared > 1e-8 ? Direction * rsqrt(LengthSquared) : float2(0.0, 1.0);
    }

    const float2 Perpendicular = float2(-Direction.y, Direction.x);
    const float2 Delta = (float2(Pixel) + 0.5) - StampCenterPixels;
    const float2 LocalPosition = float2(
        dot(Delta, Perpendicular) / max(StampHalfSizePixels.x, 0.5),
        dot(Delta, Direction) / max(StampHalfSizePixels.y, 0.5));

    const float Brush = AccumulationBrush(LocalPosition);
    if (Brush <= 0.0) return;

    const float4 Existing = TargetSurface[Pixel];
    const float ExistingAge = max(StampTimeSeconds - Existing.g, 0.0);
    const float ExistingFade = 1.0 - smoothstep(0.0, max(Existing.b, 0.01), ExistingAge);
    const float ExistingVisibleAmount = Existing.r * ExistingFade;
    const float NewAmount = saturate(max(ExistingVisibleAmount, Brush * StampAmount));

    // R=surface amount, G=spawn time, B=lifetime, A=valid. Absorbed wetness is absent.
    TargetSurface[Pixel] = float4(NewAmount, StampTimeSeconds, StampLifetimeSeconds, 1.0);
}
