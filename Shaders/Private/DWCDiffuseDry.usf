#include "/Engine/Public/Platform.ush"

Texture2D<float> SourceWetnessTexture;
RWTexture2D<float> DestinationWetnessTexture;

StructuredBuffer<uint4> TexelLookup;
StructuredBuffer<float4> TriangleFlow;

// x=dot(dPdu,dPdu), y=dot(dPdu,dPdv),
// z=dot(dPdv,dPdv), w=valid
StructuredBuffer<float4> TriangleMetric;

// x=SpreadRate/s, y=DryRate/s,
// z=GravityStrength, w=valid profile
StructuredBuffer<float4> Profiles;

StructuredBuffer<uint> TriangleProfileIndices;

int2 TextureSize;
float DeltaSeconds;
float MaxWetness;

static const float DWCSpreadResponseScale = 1.75;
static const float DWCGravityResponseScale = 1.50;

// 한 방향으로 강하게 흐르는 것은 허용한다.
static const float DWCMaxEdgeTransferFraction = 0.35;

// 하지만 한 texel이 한 step 동안 네 방향으로 내보내는 총량은 제한한다.
// 자기 질량의 절반 이상을 남겨 checkerboard/진동을 방지한다.
static const float DWCMaxTotalTransferFraction = 0.45;

static const int2 DWCNeighborOffsets[4] =
{
    int2( 1,  0),
    int2(-1,  0),
    int2( 0,  1),
    int2( 0, -1)
};

static const float2 DWCNeighborDirections[4] =
{
    float2( 1.0,  0.0),
    float2(-1.0,  0.0),
    float2( 0.0,  1.0),
    float2( 0.0, -1.0)
};

// +X <-> -X, +Y <-> -Y
static const uint DWCOppositeDirectionIndices[4] =
{
    1u,
    0u,
    3u,
    2u
};

uint Flatten(int2 Texel)
{
    return (uint)(Texel.y * TextureSize.x + Texel.x);
}

bool IsInside(int2 Texel)
{
    return
        Texel.x >= 0 &&
        Texel.y >= 0 &&
        Texel.x < TextureSize.x &&
        Texel.y < TextureSize.y;
}

bool IsValidLookup(uint4 Lookup)
{
    return Lookup.w != 0u && Lookup.x != 0xffffffffu;
}

bool IsConnectedNeighbor(uint4 SourceLookup, uint4 NeighborLookup)
{
    return
        IsValidLookup(NeighborLookup) &&
        NeighborLookup.w == SourceLookup.w;
}

float TexelArea(uint4 Lookup)
{
    if (!IsValidLookup(Lookup))
    {
        return 0.0;
    }

    const float RestArea = max(asfloat(Lookup.z), 1.0e-10);
    const float AreaScale = max(TriangleFlow[Lookup.x].z, 1.0e-4);

    return RestArea * AreaScale;
}

float EdgeFraction(uint4 Lookup, float2 DirectionUV)
{
    const uint TriangleID = Lookup.x;
    const uint ProfileIndex = TriangleProfileIndices[TriangleID];

    const float4 Profile = Profiles[ProfileIndex];
    const float4 Flow = TriangleFlow[TriangleID];
    const float4 Metric = TriangleMetric[TriangleID];

    const float2 DeltaUV =
        DirectionUV / max(float2(TextureSize), 1.0);

    const float PhysicalDistanceSquared =
        DeltaUV.x * DeltaUV.x * Metric.x +
        2.0 * DeltaUV.x * DeltaUV.y * Metric.y +
        DeltaUV.y * DeltaUV.y * Metric.z;

    const float PhysicalDistance =
        sqrt(max(PhysicalDistanceSquared, 1.0e-12));

    const float CharacteristicLength =
        sqrt(max(TexelArea(Lookup), 1.0e-12));

    const float DistanceScale =
        clamp(
            CharacteristicLength / PhysicalDistance,
            0.25,
            4.0);

    const float SpreadPerEdge =
        max(Profile.x, 0.0) *
        0.25 *
        DWCSpreadResponseScale *
        DistanceScale;

    const float FlowLength = length(Flow.xy);

    const float2 FlowDirection =
        FlowLength > 1.0e-8
            ? Flow.xy / FlowLength
            : float2(0.0, 0.0);

    const float GravityRate =
        max(Profile.z, 0.0) *
        DWCGravityResponseScale *
        saturate(FlowLength) *
        max(dot(FlowDirection, DirectionUV), 0.0) *
        DistanceScale;

    const float TimeStep = max(DeltaSeconds, 0.0);

    return min(
        saturate(TimeStep * (SpreadPerEdge + GravityRate)),
        DWCMaxEdgeTransferFraction);
}

// SourceTexel이 네 방향으로 내보내려는 raw fraction의 총합을 구한 뒤,
// 총합이 DWCMaxTotalTransferFraction을 넘으면 모든 방향을 같은 비율로 줄인다.
//
// 이 함수는:
// - 현재 texel의 OutFraction 계산
// - 이웃 texel에서 현재 texel로 들어오는 InFraction 계산
// 양쪽에 동일하게 사용해야 질량 보존이 유지된다.
float StableEdgeFraction(
    uint4 SourceLookup,
    int2 SourceTexel,
    uint RequestedDirectionIndex)
{
    float RequestedFraction = 0.0;
    float TotalFraction = 0.0;

    [unroll]
    for (uint DirectionIndex = 0u;
         DirectionIndex < 4u;
         ++DirectionIndex)
    {
        const int2 NeighborTexel =
            SourceTexel + DWCNeighborOffsets[DirectionIndex];

        if (!IsInside(NeighborTexel))
        {
            continue;
        }

        const uint4 NeighborLookup =
            TexelLookup[Flatten(NeighborTexel)];

        if (!IsConnectedNeighbor(SourceLookup, NeighborLookup))
        {
            continue;
        }

        const float Fraction =
            EdgeFraction(
                SourceLookup,
                DWCNeighborDirections[DirectionIndex]);

        TotalFraction += Fraction;

        if (DirectionIndex == RequestedDirectionIndex)
        {
            RequestedFraction = Fraction;
        }
    }

    if (TotalFraction <= 1.0e-8 ||
        TotalFraction <= DWCMaxTotalTransferFraction)
    {
        return RequestedFraction;
    }

    const float NormalizationScale =
        DWCMaxTotalTransferFraction / TotalFraction;

    return RequestedFraction * NormalizationScale;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const int2 Texel = int2(DispatchThreadId.xy);

    if (!IsInside(Texel))
    {
        return;
    }

    const uint TexelIndex = Flatten(Texel);
    const uint4 CenterLookup = TexelLookup[TexelIndex];

    if (!IsValidLookup(CenterLookup))
    {
        DestinationWetnessTexture[Texel] = 0.0;
        return;
    }

    const float CenterArea = TexelArea(CenterLookup);

    const float CenterWetness =
        max(
            SourceWetnessTexture.Load(int3(Texel, 0)),
            0.0);

    float NewMass = CenterWetness * CenterArea;

    [unroll]
    for (uint DirectionIndex = 0u;
         DirectionIndex < 4u;
         ++DirectionIndex)
    {
        const int2 NeighborTexel =
            Texel + DWCNeighborOffsets[DirectionIndex];

        if (!IsInside(NeighborTexel))
        {
            continue;
        }

        const uint4 NeighborLookup =
            TexelLookup[Flatten(NeighborTexel)];

        if (!IsConnectedNeighbor(CenterLookup, NeighborLookup))
        {
            // 서로 다른 UV island는 Seam Gather Pass에서만 통신한다.
            continue;
        }

        // 현재 texel이 이웃 방향으로 내보내는 질량.
        const float OutFraction =
            StableEdgeFraction(
                CenterLookup,
                Texel,
                DirectionIndex);

        NewMass -=
            CenterWetness *
            CenterArea *
            OutFraction;

        // 이웃 texel이 현재 texel 방향으로 내보내는 질량.
        // 이웃 기준에서는 반대 방향 인덱스를 사용한다.
        const float NeighborArea =
            TexelArea(NeighborLookup);

        const float NeighborWetness =
            max(
                SourceWetnessTexture.Load(
                    int3(NeighborTexel, 0)),
                0.0);

        const float InFraction =
            StableEdgeFraction(
                NeighborLookup,
                NeighborTexel,
                DWCOppositeDirectionIndices[DirectionIndex]);

        NewMass +=
            NeighborWetness *
            NeighborArea *
            InFraction;
    }

    const uint CenterProfileIndex =
        TriangleProfileIndices[CenterLookup.x];

    const float DryRate =
        max(Profiles[CenterProfileIndex].y, 0.0);

    const float TimeStep =
        max(DeltaSeconds, 0.0);

    NewMass =
        max(NewMass, 0.0) *
        exp(-DryRate * TimeStep);

    float NewWetness =
        NewMass / max(CenterArea, 1.0e-10);

    if (!isfinite(NewWetness))
    {
        NewWetness = 0.0;
    }

    DestinationWetnessTexture[Texel] =
        clamp(
            NewWetness,
            0.0,
            MaxWetness);
}
