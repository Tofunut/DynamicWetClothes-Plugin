#ifndef DWC_DIFFUSE_DIAGNOSTICS_USH
#define DWC_DIFFUSE_DIAGNOSTICS_USH

RWStructuredBuffer<uint> DiffuseDiagnostics;
uint DiffuseDiagnosticsEnabled;

static const uint DWC_DIAG_VALID_TEXELS = 0u;
static const uint DWC_DIAG_CONNECTED_NEIGHBORS = 1u;
static const uint DWC_DIAG_SOURCE_WET_TEXELS = 2u;
static const uint DWC_DIAG_DRY_TEXELS = 3u;
static const uint DWC_DIAG_DRY_TEXELS_WITH_INCOMING = 4u;
static const uint DWC_DIAG_LOW_WETNESS_TEXELS = 5u;
static const uint DWC_DIAG_INCOMING_POSITIVE_EDGES = 6u;
static const uint DWC_DIAG_CENTER_WETNESS_MAX = 7u;
static const uint DWC_DIAG_CENTER_AREA_MAX = 8u;
static const uint DWC_DIAG_OUT_FRACTION_MAX = 9u;
static const uint DWC_DIAG_IN_FRACTION_MAX = 10u;
static const uint DWC_DIAG_OUTGOING_MASS_MAX = 11u;
static const uint DWC_DIAG_INCOMING_MASS_MAX = 12u;
static const uint DWC_DIAG_INCOMING_MASS_ON_DRY_MAX = 13u;
static const uint DWC_DIAG_INCOMING_MASS_ON_LOW_WETNESS_MAX = 14u;
static const uint DWC_DIAG_NEW_WETNESS_MAX = 15u;
static const uint DWC_DIAG_NEW_WETNESS_ON_DRY_MAX = 16u;
static const uint DWC_DIAG_NEW_WETNESS_ON_LOW_WETNESS_MAX = 17u;
static const uint DWC_DIAG_INVALID_NUMBER_COUNT = 18u;

void DWCRecordCount(uint StatIndex)
{
    if (DiffuseDiagnosticsEnabled != 0u)
    {
        InterlockedAdd(DiffuseDiagnostics[StatIndex], 1u);
    }
}

void DWCRecordMax(uint StatIndex, float Value)
{
    if (DiffuseDiagnosticsEnabled == 0u)
    {
        return;
    }

    if (isfinite(Value) && Value >= 0.0f)
    {
        // All recorded values are non-negative, so IEEE-754 bit ordering
        // matches float ordering for InterlockedMax.
        InterlockedMax(DiffuseDiagnostics[StatIndex], asuint(Value));
    }
    else
    {
        InterlockedAdd(DiffuseDiagnostics[DWC_DIAG_INVALID_NUMBER_COUNT], 1u);
    }
}

#endif
