#include "/Engine/Private/Common.ush"

RWTexture2D<float4> TargetSurface;

int2 Resolution;
int2 StampMinPixel;
int2 StampDispatchSize;
float2 StampCenterPixels;
float2 StampHalfSizePixels;
float StampAmount;
float StampTimeSeconds;
float StampLifetimeSeconds;
float EncodedDataUVFlowAngle;
float EncodedNormalUVFlowAngle;
uint StampType;

float AccumulationBrush(float2 LocalPosition)
{
    const float Radius = length(LocalPosition);
    return 1.0 - smoothstep(0.55, 1.0, Radius);
}

float VisibleSurfaceAmount(float4 State)
{
    if (State.b <= 0.0)
    {
        return 0.0;
    }

    const float ExistingAge = max(StampTimeSeconds - State.g, 0.0);
    const float ExistingFade =
        1.0 - smoothstep(0.0, max(State.b, 0.01), ExistingAge);
    return State.r * ExistingFade;
}

[numthreads(8, 8, 1)]
void StampCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= uint2(StampDispatchSize))) return;

    const int2 Pixel = StampMinPixel + int2(DispatchThreadId.xy);
    if (any(Pixel < 0) || any(Pixel >= Resolution)) return;

    const bool IsRivulet = StampType == 1u;
    const float FlowAngle = (EncodedDataUVFlowAngle - 0.5) * 6.28318530718;
    const float2 Direction = IsRivulet
        ? float2(cos(FlowAngle), sin(FlowAngle))
        : float2(0.0, 1.0);
    const float2 Perpendicular = float2(-Direction.y, Direction.x);
    const float2 Delta = (float2(Pixel) + 0.5) - StampCenterPixels;
    const float2 LocalPosition = float2(
        dot(Delta, Perpendicular) / max(StampHalfSizePixels.x, 0.5),
        dot(Delta, Direction) / max(StampHalfSizePixels.y, 0.5));

    const float Brush = AccumulationBrush(LocalPosition);
    if (Brush <= 0.0) return;

    const float NewVisibleAmount = saturate(Brush * StampAmount);
    const float4 Existing = TargetSurface[Pixel];
    const float ExistingVisibleAmount = VisibleSurfaceAmount(Existing);

    if (IsRivulet && NewVisibleAmount < ExistingVisibleAmount)
    {
        return;
    }

    const float NewAmount = IsRivulet
        ? NewVisibleAmount
        : saturate(max(ExistingVisibleAmount, NewVisibleAmount));

    const float StateA = IsRivulet ? saturate(EncodedNormalUVFlowAngle) : 1.0;
    TargetSurface[Pixel] = float4(
        NewAmount,
        StampTimeSeconds,
        StampLifetimeSeconds,
        StateA);
}
